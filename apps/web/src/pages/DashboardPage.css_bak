@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

:root {
  --bg: #050b14;
  --surface: rgba(8, 18, 32, 0.86);
  --surface-strong: rgba(10, 22, 38, 0.94);
  --line: rgba(148, 163, 184, 0.16);
  --text: #f8fafc;
  --muted: #a7b4c7;
  --solar: #facc15;
  --home: #22a3ff;
  --battery: #2ee66b;
  --grid-export: #a855f7;
  --grid-import: #ef4444;
  --money: #fbbf24;
  --temp: #38bdf8;
}

* { box-sizing: border-box; }

.modern-dashboard {
  min-height: 100vh;
  padding: 0 clamp(18px, 2vw, 32px) 96px;
  color: var(--text);
  background:
    radial-gradient(circle at 85% 0%, rgba(95, 41, 137, 0.28), transparent 32%),
    radial-gradient(circle at 10% 0%, rgba(29, 78, 216, 0.22), transparent 30%),
    linear-gradient(180deg, #070f1f 0%, #050b14 45%, #030812 100%);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* ---------- Header (overlaid on the hero image) ---------- */

.brand-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 22px clamp(20px, 2.4vw, 36px);
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  color: inherit;
  text-decoration: none;
}

.brand-logo__mark-svg {
  filter: drop-shadow(0 0 18px rgba(250, 204, 21, 0.4));
}

.brand-logo__text {
  display: grid;
  gap: 2px;
  line-height: 1;
}

.brand-logo__text strong {
  font-family: 'Plus Jakarta Sans', Inter, sans-serif;
  font-size: clamp(1.65rem, 2.6vw, 2.15rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1;
  color: #fff;
}

.brand-logo__text strong span { color: var(--solar); }

.brand-logo__text em {
  color: #e2e8f0;
  font-size: 0.82rem;
  font-style: normal;
  font-weight: 500;
  letter-spacing: 0.01em;
  opacity: 0.95;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

.live-pill,
.user-pill {
  min-height: 52px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: rgba(8, 18, 32, 0.55);
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.live-pill__dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: var(--battery);
  box-shadow: 0 0 14px rgba(34, 197, 94, 0.8);
}

.live-pill__text,
.user-pill__text { display: grid; }

.live-pill strong,
.user-pill strong {
  font-weight: 800;
  line-height: 1.1;
}

.live-pill small,
.user-pill small {
  margin-top: 2px;
  color: var(--muted);
  font-size: 0.78rem;
}

.user-pill__avatar {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: linear-gradient(135deg, #2ee66b, #17b457);
  color: white;
  font-weight: 900;
}

/* ---------- Hero (full-bleed banner) ---------- */

.hero-overview {
  position: relative;
  min-height: 420px;
  overflow: hidden;
  border-radius: 0;
  border: 0;
  background: #081220;
  /* Break out of .modern-dashboard horizontal padding so the image spans the viewport */
  margin: 0 calc(-1 * clamp(18px, 2vw, 32px)) 24px;
}

.hero-overview__image {
  position: absolute;
  inset: 0;
  background-image: url('/solar-house-sunset.jpg');
  background-size: cover;
  background-position: center;
  opacity: 1;
}

/* Subtle top + bottom fade so the header and metric strip read cleanly,
   while keeping the middle of the image bright. */
.hero-overview__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(5, 11, 20, 0.55) 0%,
    rgba(5, 11, 20, 0.08) 18%,
    rgba(5, 11, 20, 0) 38%,
    rgba(5, 11, 20, 0) 55%,
    rgba(5, 11, 20, 0.25) 100%
  );
  pointer-events: none;
}

.hero-metrics {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  padding: 14px clamp(20px, 2.4vw, 36px);
  background: linear-gradient(
    180deg,
    rgba(5, 11, 20, 0) 0%,
    rgba(5, 11, 20, 0.55) 40%,
    rgba(5, 11, 20, 0.78) 100%
  );
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.hero-metric {
  min-height: 86px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-right: 1px solid rgba(148, 163, 184, 0.18);
}

.hero-metric:last-child { border-right: 0; }
.hero-metric__icon { display: grid; place-items: center; flex-shrink: 0; }
.hero-metric__icon svg { width: 30px; height: 30px; }
.hero-metric--solar .hero-metric__icon, .hero-metric--solar .hero-metric__subtitle { color: var(--solar); }
.hero-metric--home .hero-metric__icon, .hero-metric--home .hero-metric__subtitle { color: var(--home); }
.hero-metric--battery .hero-metric__icon, .hero-metric--battery .hero-metric__subtitle { color: var(--battery); }
.hero-metric--grid .hero-metric__icon, .hero-metric--grid .hero-metric__subtitle { color: var(--grid-export); }
.hero-metric--money .hero-metric__icon, .hero-metric--money .hero-metric__subtitle { color: var(--money); }

.hero-metric__title {
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #cbd5e1;
}

.hero-metric__value {
  margin-top: 2px;
  font-size: clamp(1.05rem, 1.5vw, 1.35rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--text);
}

.hero-metric__subtitle {
  margin-top: 2px;
  font-size: 0.72rem;
  font-weight: 600;
}

.hero-metric__link {
  display: inline-block;
  color: var(--money);
  margin-top: 2px;
  font-size: 0.68rem;
  text-decoration: none;
}

/* ---------- Section cards ---------- */

.power-flow-card,
.analytics-card,
.dashboard-error-card {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  box-shadow: 0 16px 38px rgba(0, 0, 0, 0.2);
}

.power-flow-card {
  padding: 22px 26px 22px;
  margin-bottom: 18px;
}

.section-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.section-title-row h2,
.analytics-card h2 {
  margin: 0;
  font-size: 1.08rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.025em;
}

.section-title-row p {
  margin: 8px 0 0;
  color: var(--muted);
}

.ghost-help {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  border-radius: 8px;
  border: 1px solid var(--line);
  color: var(--text);
  background: rgba(15, 23, 42, 0.7);
  font-weight: 700;
  cursor: pointer;
}

/* ---------- Power Flow ---------- */

.power-flow-visual {
  position: relative;
  min-height: 560px;
  margin-top: 18px;
}

.flow-node {
  position: absolute;
  display: grid;
  justify-items: center;
  text-align: center;
  z-index: 3;
}

/* Sun sits centered at the top; home sits centered in the middle row;
   battery and grid sit on the SAME horizontal baseline as home. */
.flow-node--solar { top: 10px; left: 50%; transform: translateX(-50%); }
.flow-node--home { top: 278px; left: 50%; transform: translateX(-50%); }
.flow-node--battery { top: 278px; left: 8%; }
.flow-node--grid { top: 278px; right: 8%; }

.flow-node__circle {
  position: relative;
  width: 132px;
  height: 132px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: radial-gradient(circle at 50% 45%, rgba(30, 41, 59, 0.86), rgba(6, 14, 25, 0.96));
  border: 5px solid currentColor;
  color: currentColor;
  box-shadow: 0 0 42px color-mix(in srgb, currentColor 26%, transparent);
}

.flow-node__circle--solar { color: var(--solar); }
.flow-node__circle--home { color: var(--home); }
.flow-node__circle--battery { color: var(--battery); }
.flow-node__circle--grid-export { color: var(--grid-export); }
.flow-node__circle--grid-import { color: var(--grid-import); }

.flow-node__label {
  margin-top: 15px;
  font-size: 0.88rem;
  font-weight: 900;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.flow-node__value {
  margin-top: 5px;
  font-size: clamp(1.6rem, 2.4vw, 2rem);
  line-height: 1;
  font-weight: 900;
  letter-spacing: -0.06em;
}

.flow-node__status {
  min-height: 22px;
  margin-top: 8px;
  color: currentColor;
  font-size: 1rem;
  font-weight: 700;
}

/* Inline label that sits next to the solar ring */
.flow-node__side-label {
  position: absolute;
  z-index: 3;
  display: grid;
  gap: 4px;
  text-align: left;
}

.flow-node__side-label--solar {
  top: 46px;
  left: calc(50% + 110px);
  min-width: 150px;
}

.flow-node__side-label .flow-node__label {
  color: var(--muted);
  margin-top: 0;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.flow-node__side-label .flow-node__value {
  color: var(--text);
  margin-top: 0;
  font-size: clamp(1.6rem, 2.2vw, 2rem);
}
.flow-node__side-label .flow-node__status {
  color: var(--muted);
  margin-top: 0;
  font-size: 0.88rem;
  font-weight: 600;
}

/* Solar efficiency ring — thin stroke, sits just outside the circle */
.solar-efficiency-ring {
  position: absolute;
  inset: -8px;
  width: 148px;
  height: 148px;
  transform: rotate(-90deg);
  pointer-events: none;
  overflow: visible;
}

.solar-efficiency-ring__track,
.solar-efficiency-ring__value {
  fill: none;
  stroke-width: 4;
}

.solar-efficiency-ring__track { stroke: rgba(148, 163, 184, 0.18); }
.solar-efficiency-ring__value {
  stroke: var(--solar);
  stroke-linecap: round;
  stroke-dasharray: 339.292;
  stroke-dashoffset: calc(339.292 - (339.292 * var(--ring-progress)) / 100);
  filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.45));
  transition: stroke-dashoffset 420ms ease;
}

/* Solar % label inside the circle, below the sun icon */
.solar-percent {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22px;
  text-align: center;
  color: var(--solar);
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  text-shadow: 0 0 12px rgba(250, 204, 21, 0.45);
  pointer-events: none;
}

/* Battery state-of-charge ring (mirror of solar-efficiency-ring) */
.battery-soc-ring {
  position: absolute;
  inset: -8px;
  width: 148px;
  height: 148px;
  transform: rotate(-90deg);
  pointer-events: none;
  overflow: visible;
}
.battery-soc-ring__track,
.battery-soc-ring__value {
  fill: none;
  stroke-width: 4;
}
.battery-soc-ring__track { stroke: rgba(148, 163, 184, 0.18); }
.battery-soc-ring__value {
  stroke: var(--battery);
  stroke-linecap: round;
  stroke-dasharray: 339.292;
  stroke-dashoffset: calc(339.292 - (339.292 * var(--ring-progress)) / 100);
  filter: drop-shadow(0 0 8px rgba(46, 230, 107, 0.55));
  transition: stroke-dashoffset 420ms ease;
}

/* Battery % label inside the circle, below the icon */
.battery-percent {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22px;
  text-align: center;
  color: var(--battery);
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  text-shadow: 0 0 12px rgba(46, 230, 107, 0.45);
  pointer-events: none;
}

/* Flow arrow streams */
.flow-line {
  --flow-speed: 1s;
  position: absolute;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  pointer-events: none;
}

.flow-line--solar-home {
  top: 152px;
  left: 50%;
  width: 60px;
  height: 130px;
  transform: translateX(-50%);
  flex-direction: column;
  gap: 10px;
}
/* Horizontal streams sit at the vertical center of the middle row (home/battery/grid): 278 + 132/2 = 344 */
.flow-line--battery-home {
  top: 330px;
  left: calc(8% + 138px);
  right: calc(50% + 80px);
}
.flow-line--grid-home {
  top: 330px;
  left: calc(50% + 80px);
  right: calc(8% + 138px);
}

.flow-arrow {
  font-size: 3rem;
  line-height: 0.8;
  font-weight: 900;
  opacity: 0;
  animation: flowPulse var(--flow-speed) linear infinite;
}
.flow-line--solar .flow-arrow { color: var(--solar); text-shadow: 0 0 20px rgba(250, 204, 21, 0.8); }
.flow-line--battery .flow-arrow { color: var(--battery); text-shadow: 0 0 20px rgba(34, 197, 94, 0.8); }
.flow-line--grid-export .flow-arrow { color: var(--grid-export); text-shadow: 0 0 20px rgba(168, 85, 247, 0.8); }
.flow-line--grid-import .flow-arrow { color: var(--grid-import); text-shadow: 0 0 20px rgba(239, 68, 68, 0.8); }

@keyframes flowPulse {
  0% { opacity: 0; transform: scale(0.84); }
  35% { opacity: 1; transform: scale(1.12); }
  100% { opacity: 0; transform: scale(0.84); }
}

.flow-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24px;
  padding-top: 8px;
  color: #d7deea;
  font-size: 0.92rem;
}
.flow-legend span { display: inline-flex; align-items: center; gap: 8px; }
.legend-dot { width: 9px; height: 9px; border-radius: 999px; display: inline-block; }
.legend-dot--solar { background: var(--solar); }
.legend-dot--home { background: var(--home); }
.legend-dot--battery { background: var(--battery); }
.legend-dot--export { background: var(--grid-export); }
.legend-dot--import { background: var(--grid-import); }

/* ---------- Analytics grid (chart + status) ---------- */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(300px, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}

.analytics-card {
  padding: 22px;
  min-height: 210px;
}
.analytics-card--wide { min-height: 340px; display: flex; flex-direction: column; }

.segmented-tabs {
  display: inline-flex;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(15, 23, 42, 0.35);
}
.segmented-tabs button {
  padding: 8px 16px;
  color: var(--muted);
  border: 0;
  border-right: 1px solid var(--line);
  font-weight: 800;
  font-size: 0.86rem;
  background: transparent;
  cursor: pointer;
  font-family: inherit;
}
.segmented-tabs button:last-child { border-right: 0; }
.segmented-tabs button:hover { color: var(--text); }
.segmented-tabs button.active { background: rgba(34, 163, 255, 0.2); color: #70c6ff; }

.chart-container {
  margin-top: 18px;
  height: 240px;
  flex: 1;
}

.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  padding-top: 12px;
  color: #d7deea;
  font-size: 0.88rem;
}
.chart-legend span { display: inline-flex; align-items: center; gap: 8px; }

/* System Status card */
.status-card .status-list {
  margin: 18px 0 0;
  display: grid;
  gap: 14px;
}
.status-card .status-list div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  padding-bottom: 12px;
}
.status-card .status-list dt { color: var(--muted); font-weight: 600; }
.status-card .status-list dd { margin: 0; font-weight: 800; }
.status-online { color: var(--battery); }
.status-online span {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-left: 7px;
  border-radius: 50%;
  background: var(--battery);
  box-shadow: 0 0 10px rgba(46, 230, 107, 0.7);
  vertical-align: middle;
}

.status-facts {
  margin-top: 18px;
  padding: 16px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(15, 23, 42, 0.4);
  display: grid;
  gap: 12px;
}
.status-fact {
  display: grid;
  grid-template-columns: 18px 1fr auto auto;
  align-items: center;
  gap: 10px;
  font-size: 0.92rem;
}
.status-fact__icon--solar { color: var(--solar); }
.status-fact__icon--home { color: var(--home); }
.status-fact__icon--battery { color: var(--battery); }
.status-fact__label { color: var(--muted); font-weight: 600; }
.status-fact__value { color: var(--text); font-weight: 800; }
.status-fact__tag {
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 800;
}
.status-fact__tag--ok {
  color: var(--battery);
  background: rgba(46, 230, 107, 0.14);
}

/* ---------- Dashboard tiles row ---------- */

.dashboard-tiles {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr)) minmax(260px, 1.6fr);
  gap: 12px;
  margin-bottom: 14px;
}

.mini-tile {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  padding: 16px 14px;
  display: grid;
  gap: 4px;
  justify-items: start;
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.18);
}

.mini-tile__icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  margin-bottom: 4px;
  background: rgba(15, 23, 42, 0.55);
  border: 1px solid rgba(148, 163, 184, 0.12);
}
.mini-tile--solar .mini-tile__icon { color: var(--solar); }
.mini-tile--home .mini-tile__icon { color: var(--home); }
.mini-tile--battery .mini-tile__icon { color: var(--battery); }
.mini-tile--grid .mini-tile__icon { color: var(--grid-export); }
.mini-tile--temp .mini-tile__icon { color: var(--temp); }

.mini-tile__label {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 0.02em;
}
.mini-tile__value {
  font-size: clamp(1.2rem, 1.7vw, 1.45rem);
  font-weight: 900;
  letter-spacing: -0.04em;
}
.mini-tile__caption { font-size: 0.82rem; font-weight: 700; }
.mini-tile__caption--mute { color: var(--muted); }
.mini-tile__caption--ok { color: var(--battery); }
.mini-tile__caption--warn { color: var(--grid-import); }
.mini-tile__caption--accent { color: var(--home); }

.mini-tile--solar .mini-tile__caption--mute { color: var(--solar); }
.mini-tile--home .mini-tile__caption--mute { color: var(--home); }
.mini-tile--battery .mini-tile__caption--mute { color: var(--battery); }
.mini-tile--grid .mini-tile__caption--mute { color: var(--grid-export); }

/* Savings CTA card */
.savings-cta {
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 18px 20px;
  background:
    radial-gradient(circle at 100% 0%, rgba(250, 204, 21, 0.2), transparent 55%),
    var(--surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.24);
  overflow: hidden;
}
.savings-cta__body { display: grid; gap: 6px; max-width: 70%; }
.savings-cta__body h3 {
  margin: 0;
  font-size: 1.02rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 1.2;
}
.savings-cta__body p {
  margin: 0;
  color: var(--muted);
  font-size: 0.86rem;
}
.savings-cta__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  padding: 9px 14px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(250, 204, 21, 0.2), rgba(250, 204, 21, 0.08));
  border: 1px solid rgba(250, 204, 21, 0.45);
  color: var(--solar);
  font-weight: 800;
  text-decoration: none;
  font-size: 0.88rem;
  width: max-content;
}
.savings-cta__button:hover {
  background: linear-gradient(135deg, rgba(250, 204, 21, 0.3), rgba(250, 204, 21, 0.12));
}
.savings-cta__art {
  color: var(--solar);
  opacity: 0.55;
  filter: drop-shadow(0 0 18px rgba(250, 204, 21, 0.35));
}

.dashboard-error-card { padding: 24px; }

/* ---------- Responsive ---------- */

@media (max-width: 1260px) {
  .dashboard-tiles {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .savings-cta { grid-column: 1 / -1; }
}

@media (max-width: 1180px) {
  .hero-overview { min-height: 380px; }
  .hero-metrics { grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 12px 14px; }
  .hero-metric { padding: 10px 10px; min-height: 80px; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .flow-node__side-label--solar { top: 30px; left: calc(50% + 96px); min-width: 130px; }
}

@media (max-width: 860px) {
  .modern-dashboard { padding: 0 14px 92px; }
  .brand-header { align-items: flex-start; flex-direction: column; padding: 16px 18px; }
  .header-actions { width: 100%; flex-direction: row; align-items: stretch; gap: 10px; }
  .live-pill, .user-pill { flex: 1; }
  .hero-overview { min-height: 520px; margin-left: -14px; margin-right: -14px; }
  .hero-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero-metric:nth-child(5) { grid-column: 1 / -1; }
  .power-flow-card { padding: 18px 14px; }
  .power-flow-visual { min-height: 720px; }
  .flow-node__circle { width: 106px; height: 106px; }
  .solar-efficiency-ring,
  .battery-soc-ring { width: 118px; height: 118px; inset: -6px; }
  .flow-node--solar { top: 0; }
  .flow-node--home { top: 300px; }
  .flow-node--battery { top: 300px; left: 6%; }
  .flow-node--grid { top: 300px; right: 6%; }
  .flow-line--solar-home { top: 140px; height: 140px; }
  .flow-line--battery-home { top: 342px; left: calc(6% + 110px); right: calc(50% + 60px); gap: 6px; }
  .flow-line--grid-home { top: 342px; left: calc(50% + 60px); right: calc(6% + 110px); gap: 6px; }
  .flow-arrow { font-size: 2.2rem; }
  .dashboard-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .savings-cta { grid-column: 1 / -1; }
}
